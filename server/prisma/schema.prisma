generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User role enum (Optional later)
// User role enum
enum Role {
  SUPERADMIN
  OWNER
  SUPERVISOR
  KASIR
}

model Business {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // Subdomain or URL identifier (e.g. "laundry-abc")
  name      String
  address   String?
  phone     String?
  ownerId   Int      // The User who owns this business
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  users           User[]
  customers       Customer[]
  categories      Category[]
  brands          Brand[]
  items           Item[]
  transactions    Transaction[]
  payments        Payment[]
  shifts          Shift[]
  expenses        Expense[]
  laundryPartners LaundryPartner[]
  referralCodes   ReferralCode[]
  broadcastTemplates BroadcastTemplate[]
  appSettings     AppSetting[]
  violationTypes  ViolationType[]
  paymentMethods  PaymentMethod[]
  colors          Color[]
  sizes           Size[]

  // Added missing relations
  referralPartners ReferralPartner[]
  laundryBatches   LaundryBatch[]
  expenseCategories ExpenseCategory[]
  broadcasts       Broadcast[]
  depositVariants  DepositVariant[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String?
  role      Role     @default(KASIR)
  
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])

  transactions Transaction[]
  expenses  Expense[]
  pickedUpTransactions Transaction[] @relation("PickedUpBy")
  returnedTransactions Transaction[] @relation("ReturnedBy")
  createdPayments      Payment[]
  shifts               Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Customer {
  id                  Int           @id @default(autoincrement())
  
  businessId          Int?
  business            Business?     @relation(fields: [businessId], references: [id])
  
  name                String
  phone               String        // removed unique constraint for multi-tenant (or make composite unique)
  email               String?       // Will be filled for all new customers
  address             String?
  identityCardNumber  String?       // removed unique constraint for multi-tenant
  identityCardImage   String?       // URL/Path to KTP Image
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  transactions        Transaction[]
}

model Category {
  id        Int      @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name      String   
  items     Item[]
}

model Brand {
  id    Int    @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name  String 
  items Item[]
}

model Item {
  id          Int            @id @default(autoincrement())
  businessId  Int?
  business    Business?      @relation(fields: [businessId], references: [id])
  
  name        String
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  brandId     Int
  brand       Brand          @relation(fields: [brandId], references: [id])
  rentalPrice Float
  description String?
  images      ItemImage[]
  variants    ItemVariant[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ItemImage {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String   // Relative URL e.g. /uploads/image.jpg
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Color {
  id       Int           @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name     String        
  hexCode  String?
  variants ItemVariant[]
}

model Size {
  id       Int           @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name     String        
  variants ItemVariant[]
}

model ItemVariant {
  id                Int       @id @default(autoincrement())
  itemId            Int
  item              Item      @relation(fields: [itemId], references: [id])
  sizeId            Int
  size              Size      @relation(fields: [sizeId], references: [id])
  colorId           Int
  color             Color     @relation(fields: [colorId], references: [id])
  
  instances         ItemInstance[]
  createdAt         DateTime  @default(now())

  @@unique([itemId, sizeId, colorId])
}

enum ItemStatus {
  AVAILABLE
  RENTED
  IN_LAUNDRY
  NOT_READY // Damaged, Lost, etc.
}

model ItemInstance {
  sku               String            @id // Unique Barcode/SKU - KEEP UNIQUE GLOBAL for simplicity or composite? Keep global for now.
  itemVariantId     Int
  itemVariant       ItemVariant       @relation(fields: [itemVariantId], references: [id])
  status            ItemStatus        @default(AVAILABLE)
  
  transactionItems  TransactionItem[]
  laundryLogs       LaundryLog[]
  createdAt         DateTime          @default(now())
}

enum TransactionStatus {
  BOOKED          // Initial booking
  WAITING_PICKUP  // Ready for pickup (H-1)
  RENTED          // Active rental (Picked up)
  RETURNED        // Items returned (but maybe fines unpaid)
  COMPLETED       // Fully done
  CANCELLED
  EXPIRED         // Valid Booking but never picked up
}

enum TransactionType {
  BOOKING
  IMMEDIATE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TransactionSource {
  OFFLINE
  ONLINE
}

model Transaction {
  id               Int               @id @default(autoincrement())
  businessId       Int?
  business         Business?         @relation(fields: [businessId], references: [id])

  type             TransactionType   @default(BOOKING)
  source           TransactionSource @default(OFFLINE)
  customerId       Int
  customer         Customer          @relation(fields: [customerId], references: [id])
  userId           Int?
  user             User?             @relation(fields: [userId], references: [id])
  pickedUpById     Int?
  pickedUpBy       User?             @relation("PickedUpBy", fields: [pickedUpById], references: [id])
  returnedById     Int?
  returnedBy       User?             @relation("ReturnedBy", fields: [returnedById], references: [id])
  bookingDate      DateTime          @default(now())
  pickupDate       DateTime
  returnPlanDate   DateTime
  actualReturnDate DateTime?
  status           TransactionStatus @default(BOOKED)
  totalAmount      Float
  paidAmount       Float             @default(0)
  adminFee         Float             @default(0)
  paymentStatus    PaymentStatus     @default(UNPAID)
  
  taxRate          Float             @default(0) // Percentage (e.g., 11 for 11%)
  taxAmount        Float             @default(0) // Calculated Tax Amount

  depositAmount     Float         @default(0)
  depositStatus     String?       // HELD, REFUNDED, DEDUCTED, PARTIAL
  
  items            TransactionItem[]
  payments         Payment[]
  fines            Fine[]
  
  referralCodeId   Int?
  referralCode     ReferralCode?     @relation(fields: [referralCodeId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  note             String?
  saasFeeLog       SaaSFeeLog?
  commissionLog    CommissionLog?    @relation("TransactionCommission")
}

model SaaSFeeLog {
    id              Int         @id @default(autoincrement())
    transactionId   Int         @unique
    transaction     Transaction @relation(fields: [transactionId], references: [id])
    
    amount          Float
    calculationDetails String?   // "Rp 1000 x 5 Items" or "10% of Rp 500.000"
    chargedTo       String      // "CUSTOMER" or "MERCHANT"
    
    createdAt       DateTime @default(now())
}

model ReferralPartner {
  id        Int            @id @default(autoincrement())
  businessId Int?
  business   Business?     @relation(fields: [businessId], references: [id])
  name      String
  phone     String?
  email     String?
  bankInfo  String?        // Bank name, Account number, Holder name
  codes     ReferralCode[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum ReferralDiscountType {
  PERCENTAGE
  FIXED
}

model ReferralCode {
  id               Int                  @id @default(autoincrement())
  businessId       Int?
  business         Business?            @relation(fields: [businessId], references: [id])
  code             String               // Removed unique constraint for multi-tenancy preparation
  partnerId        Int
  partner          ReferralPartner      @relation(fields: [partnerId], references: [id])
  discountType     ReferralDiscountType @default(PERCENTAGE)
  discountValue    Float
  commissionRate   Float                // Percentage e.g. 5 for 5%
  isActive         Boolean              @default(true)
  transactions     Transaction[]
  commissionLogs   CommissionLog[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model CommissionLog {
  id              Int          @id @default(autoincrement())
  referralCodeId  Int
  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id])
  transactionId   Int?         @unique
  transaction     Transaction? @relation("TransactionCommission", fields: [transactionId], references: [id])
  amount          Float        // Calculated commission amount
  status          String       @default("PENDING") // PENDING, PAID
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  itemInstanceSku String
  itemInstance  ItemInstance @relation(fields: [itemInstanceSku], references: [sku])
  priceAtRental Float
}

enum PaymentMethodType {
  CASH
  TRANSFER
  GATEWAY
}

model PaymentMethod {
  id       Int               @id @default(autoincrement())
  businessId Int?
  business   Business?       @relation(fields: [businessId], references: [id])
  name     String            // Removed unique
  type     PaymentMethodType @default(CASH)
  account  String?           // Rekening number
  payments Payment[]
}

model Payment {
  id              Int           @id @default(autoincrement())
  businessId      Int?
  business        Business?     @relation(fields: [businessId], references: [id])
  transactionId   Int
  transaction     Transaction   @relation(fields: [transactionId], references: [id])
  amount          Float
  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  date            DateTime      @default(now())
  note            String?
  createdById     Int?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  shiftId         Int?
  shift           Shift?        @relation(fields: [shiftId], references: [id])
}

model ViolationType {
  id          Int     @id @default(autoincrement())
  businessId  Int?
  business    Business? @relation(fields: [businessId], references: [id])
  name        String  // Removed unique
  defaultFine Float   @default(0)
  fines       Fine[]
}

model Fine {
  id              Int           @id @default(autoincrement())
  transactionId   Int
  transaction     Transaction   @relation(fields: [transactionId], references: [id])
  violationTypeId Int
  violationType   ViolationType @relation(fields: [violationTypeId], references: [id])
  amount          Float
  note            String?
  createdAt       DateTime      @default(now())
}

model LaundryPartner {
  id        Int            @id @default(autoincrement())
  businessId Int?
  business   Business?     @relation(fields: [businessId], references: [id])
  name      String
  phone     String?
  address   String?
  createdAt DateTime       @default(now())
  batches   LaundryBatch[]
}

model LaundryBatch {
  id              Int            @id @default(autoincrement())
  businessId      Int?
  business        Business?      @relation(fields: [businessId], references: [id])
  partnerId       Int
  partner         LaundryPartner @relation(fields: [partnerId], references: [id])
  sentDate        DateTime       @default(now())
  completedDate   DateTime?
  expense         Float          @default(0)
  status          String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  note            String?
  logs            LaundryLog[]
  createdAt       DateTime       @default(now())
}

model LaundryLog {
  id                 Int           @id @default(autoincrement())
  itemInstanceSku    String
  itemInstance       ItemInstance  @relation(fields: [itemInstanceSku], references: [sku])
  status             String        @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED
  batchId            Int?
  batch              LaundryBatch? @relation(fields: [batchId], references: [id])
  createdAt          DateTime      @default(now())
  completedDate      DateTime?
}

model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name      String    // Removed unique
  expenses  Expense[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  businessId  Int?
  business    Business? @relation(fields: [businessId], references: [id])
  type        String   // LAUNDRY, OTHER
  amount      Float
  description String
  date        DateTime @default(now())
  
  categoryId  Int?     // Made optional for migration safety, but goal is to make it required
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  
  referenceId Int?     // LaundryBatch ID if type is LAUNDRY
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model DepositVariant {
  id        Int      @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name      String
  amount    Float
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model AppSetting {
  id        Int    @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  key       String // Removed unique for multi-tenant (unique per business later)
  value     String
  description String?
}

model BroadcastTemplate {
  id        Int      @id @default(autoincrement())
  businessId Int?
  business   Business? @relation(fields: [businessId], references: [id])
  name      String   // Removed unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  broadcasts Broadcast[]
}

model Broadcast {
  id          Int               @id @default(autoincrement())
  businessId  Int?
  business    Business?         @relation(fields: [businessId], references: [id])
  templateId  Int?
  template    BroadcastTemplate? @relation(fields: [templateId], references: [id])
  name        String?           // Optional name for the broadcast campaign
  content     String            @db.Text
  scheduledAt DateTime?
  status      BroadcastStatus   @default(PENDING)
  targets     Json              // Array of { phone: string, name: string }
  results     Json?             // Array of { phone: string, status: string, error?: string }
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum BroadcastStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Shift {
  id           Int       @id @default(autoincrement())
  businessId   Int?
  business     Business? @relation(fields: [businessId], references: [id])
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  startTime    DateTime  @default(now())
  endTime      DateTime?
  startCash    Float     @default(0)
  expectedCash Float     @default(0) // Sum of cash payments during shift
  actualCash   Float?    // Entered by user at close
  variance     Float?    // expected - actual
  status       String    @default("OPEN") // OPEN, CLOSED
  notes        String?   @db.Text
  payments     Payment[]
  createdAt    DateTime  @default(now())
}
